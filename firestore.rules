rules_version = '2';
// Paste these into Firebase console → Firestore Database → Rules → Publish.
// Each signed-in person can read and write only their own progress; nobody can list or read anyone else's.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/sites/{site} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['state', 'updatedAt', 'v'])
        && request.resource.data.state is string
        && request.resource.data.state.size() < 300000;
    }
  }
}
